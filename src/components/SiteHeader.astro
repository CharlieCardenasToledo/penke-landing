---
import Icon from "./Icon.astro";

interface Props { home?: boolean; }
const { home = false } = Astro.props;
// En páginas internas los anclajes apuntan a la portada
const base = home ? "" : "/";
---
<header class="site-header sticky top-0 z-40 border-b border-transparent bg-white/90 backdrop-blur-md" data-scrolled="false">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-5 sm:px-8">
    <a href={home ? "#top" : "/"} class="flex items-center" aria-label="Penké, ir al inicio">
      <img src="/brand/penke-imagotipo.svg" alt="Penké" width="116" height="33" class="h-8 w-auto" />
    </a>

    <nav aria-label="Secciones" class="hidden items-center gap-1 md:flex">
      <a href={`${base}#como-funciona`} class="rounded-lg px-3 py-2 text-sm font-medium text-ink-soft hover:bg-mist hover:text-ink">Cómo funciona</a>
      <a href={`${base}#funciones`} class="rounded-lg px-3 py-2 text-sm font-medium text-ink-soft hover:bg-mist hover:text-ink">Funciones</a>
      <a href={`${base}#privacidad`} class="rounded-lg px-3 py-2 text-sm font-medium text-ink-soft hover:bg-mist hover:text-ink">Privacidad</a>
      <a href={`${base}#preguntas`} class="rounded-lg px-3 py-2 text-sm font-medium text-ink-soft hover:bg-mist hover:text-ink">Preguntas</a>
    </nav>

    <a href={`${base}#descargar`}
      class="inline-flex h-10 items-center gap-2 rounded-xl bg-brand px-4 text-sm font-semibold text-white shadow-sm hover:bg-brand-dark">
      <Icon name="download" size={16} />
      Descargar
    </a>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>(".site-header");
  const update = () => header?.setAttribute("data-scrolled", String(window.scrollY > 8));
  window.addEventListener("scroll", update, { passive: true });
  update();
</script>
