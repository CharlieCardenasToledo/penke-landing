---
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Penke - Tu firma digital, autentica",
  description = "Firma, verifica y valida documentos PDF con tu certificado digital acreditado en Ecuador. Sin instalar Java. Sin configuraciones complejas.",
} = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="firma digital Ecuador, firmar PDF, certificado digital, FirmaEC, Penke" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/screenshots/home.jpg" />
    <link rel="icon" type="image/png" href="/brand/penke-app-icon.png" />
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body class="bg-white text-slate-900 antialiased">
    <slot />
  </body>
</html>
