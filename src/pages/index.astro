---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { getRelease } from "../lib/githubReleases";

// Versión publicada, para mostrarla junto a la descarga (la página es SSR)
let version: string | null = null;
try {
  version = (await getRelease("latest"))?.tag_name.replace(/^v/, "") ?? null;
} catch {
  version = null;
}

const pasos = [
  { n: "1", titulo: "Arrastra el PDF", texto: "Desde el escritorio, el correo o cualquier carpeta. Nada de buscar el archivo carpeta por carpeta." },
  { n: "2", titulo: "Ubica tu firma", texto: "Haz clic donde va. Achícala si el espacio es pequeño o repítela en otras hojas del documento." },
  { n: "3", titulo: "Firma y envía", texto: "Confirma con tu contraseña y comparte el PDF firmado por WhatsApp o correo, sin salir de Penké." },
];

const funciones = [
  { icono: "layers", titulo: "La misma firma en varias hojas", texto: "Pon tu firma en todas las hojas que la necesiten, en la misma posición, en un solo paso." },
  { icono: "building", titulo: "Sello con los datos de tu empresa", texto: "Si firmas como representante legal, el sello muestra tu cargo, la razón social y el RUC." },
  { icono: "qr", titulo: "QR verificable", texto: "Opcional: el QR del sello abre una página que confirma la firma y detecta si el PDF fue alterado." },
  { icono: "key", titulo: "Archivo .p12 o token USB", texto: "Firma con el archivo de tu certificado o con tu token. Para el token solo necesitas el driver de tu proveedor." },
  { icono: "share", titulo: "Comparte al instante", texto: "Envía el PDF firmado por WhatsApp, correo o Teams desde el panel Compartir de Windows." },
  { icono: "files", titulo: "Varios PDF a la vez", texto: "Firma un lote de documentos con el mismo perfil, sin repetir los pasos en cada uno." },
] as const;

const comparacion = [
  ["Cargas el certificado cada vez que abres la aplicación.", "Tu perfil de firma queda guardado."],
  ["Buscas el PDF navegando carpeta por carpeta.", "Arrastras el PDF desde donde esté."],
  ["Instalas Java por separado.", "Un solo instalador y listo."],
];

const preguntas = [
  { q: "¿Las firmas de Penké son válidas?", a: "Sí. Penké genera firmas PAdES, el formato estándar de firma en PDF, con tu certificado de una entidad acreditada en Ecuador. Puedes comprobarlas en el validador oficial FirmaEC o en Adobe Acrobat." },
  { q: "¿Penké es la aplicación oficial FirmaEC del MINTEL?", a: "No. Penké es una aplicación independiente con su propio motor de firma. Usa tu mismo certificado de firma electrónica y produce firmas que el validador oficial FirmaEC reconoce; lo que cambia es lo simple que es firmar." },
  { q: "¿Tengo que instalar Java u otro programa?", a: "No. El instalador de Penké trae todo lo necesario. Si firmas con token USB, solo necesitas el driver oficial de tu proveedor, igual que con cualquier otra aplicación." },
  { q: "¿Con qué certificados funciona?", a: "Con certificados de las entidades de certificación acreditadas en Ecuador, en archivo (.p12 o .pfx) o en token USB. Antes de firmar, Penké comprueba que tu certificado esté vigente y no haya sido revocado." },
  { q: "¿Mis documentos se envían a algún servidor?", a: "No. Tus PDF, tu certificado y tu clave privada se quedan en tu computadora. Penké solo se conecta para consultar si tu certificado fue revocado, para buscar actualizaciones y, si activas el QR verificable, para publicar los datos del sello (nunca el documento)." },
  { q: "¿Qué es el QR verificable?", a: "Una opción que puedes activar en tu perfil. El QR del sello lleva a una página de penke.nekateklabs.com que muestra quién firmó y cuándo, y permite comprobar si el PDF fue modificado sin subirlo." },
  { q: "¿Puedo achicar la firma o ponerla en varias hojas?", a: "Sí. En el visor haces clic donde va la firma, la arrastras, la agrandas o achicas desde sus esquinas y, con \"Otra firma\", la repites en otras hojas. Si tapa una firma que el documento ya tiene, Penké te avisa." },
  { q: "¿Cuánto cuesta?", a: "Nada. Penké es gratis para uso personal, profesional o institucional, sin suscripciones ni límites de uso." },
  { q: "¿Cómo se actualiza?", a: "Penké te avisa cuando hay una versión nueva, te muestra sus novedades y se actualiza sola con paquetes firmados. Si tienes una versión anterior a la 1.0.13, descarga la versión actual una vez desde esta página; las siguientes llegarán solas." },
];

const title = "Penké — Firma electrónica de PDF en Ecuador, gratis";
const description = "Firma tus PDF con tu certificado de Ecuador (.p12 o token USB) en segundos: arrastra el documento, ubica tu firma y listo. Válido en FirmaEC. Gratis para Windows, macOS y Linux.";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Penké",
    url: "https://penke.nekateklabs.com/",
    image: "https://penke.nekateklabs.com/screenshots/og-penke.jpg",
    applicationCategory: "BusinessApplication",
    applicationSubCategory: "Firma electrónica de documentos PDF",
    ...(version ? { softwareVersion: version } : {}),
    operatingSystem: "Windows, macOS, Linux",
    inLanguage: "es-EC",
    description,
    featureList: ["Firma electrónica de PDF", "Firma en varias hojas", "Firma en lote", "QR verificable", "Verificación de firmas", "Revisión de certificados"],
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    downloadUrl: "https://penke.nekateklabs.com/descargar",
    author: { "@type": "Person", name: "Charlie Cárdenas Toledo" },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: preguntas.map((p) => ({ "@type": "Question", name: p.q, acceptedAnswer: { "@type": "Answer", text: p.a } })),
  },
];
---
<Base title={title} description={description} canonical="https://penke.nekateklabs.com/" structuredData={structuredData} home>

  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section id="top" class="relative overflow-hidden">
    <div class="absolute inset-x-0 bottom-0 h-[42%] bg-mist" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-5 pt-14 sm:px-8 sm:pt-20">
      <div class="mx-auto max-w-3xl text-center">
        <a href="#funciones" class="inline-flex items-center gap-2 rounded-full border border-line bg-white py-1 pl-1 pr-3 text-xs font-medium text-ink-soft hover:border-brand/40 hover:text-ink">
          <span class="rounded-full bg-brand-tint px-2 py-0.5 font-semibold text-brand">Nuevo</span>
          Firma en varias hojas a la vez
          <Icon name="arrow-right" size={14} />
        </a>
        <h1 class="mt-6 text-4xl font-extrabold leading-[1.08] tracking-[-0.025em] sm:text-5xl md:text-6xl">
          Firma tus PDF con tu certificado, en segundos
        </h1>
        <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-ink-soft">
          Arrastra el documento, ubica tu firma y listo. Penké guarda tu perfil para que no vuelvas
          a cargar el certificado cada vez, y sus firmas se validan en FirmaEC.
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a href="/descargar?os=windows" data-descarga-principal
            class="inline-flex h-12 w-full items-center justify-center gap-2 rounded-xl bg-brand px-6 text-base font-semibold text-white shadow-sm hover:bg-brand-dark sm:w-auto">
            <Icon name="download" size={18} />
            <span data-descarga-texto>Descargar para Windows</span>
          </a>
          <a href="#descargar" class="inline-flex h-12 w-full items-center justify-center rounded-xl border border-line bg-white px-5 text-base font-semibold text-ink hover:border-slate-300 hover:bg-mist sm:w-auto">
            Otros sistemas
          </a>
        </div>
        <p class="mt-4 text-sm text-ink-muted">
          Gratis{version && <> · Versión {version}</>} · Windows, macOS y Linux
        </p>
      </div>

      <figure class="rise rise-delay relative mx-auto mt-12 max-w-5xl sm:mt-14">
        <div class="app-shot">
          <img src="/screenshots/app-firmar.webp" width="2000" height="1250" fetchpriority="high"
            alt="Visor de Penké con un contrato de tres páginas: la firma de María José Peña está ubicada sobre su línea de firma y el botón dice «Listo, poner 2 firmas»." />
        </div>
        <figcaption class="sr-only">Ubicar la firma en el visor de Penké (datos de demostración).</figcaption>
      </figure>
    </div>
  </section>

  <!-- ── Confianza ────────────────────────────────────────────────────── -->
  <section class="border-b border-line bg-mist">
    <div class="mx-auto max-w-6xl px-5 py-10 sm:px-8">
      <p class="text-center text-sm font-medium text-ink-muted">Funciona con certificados de las entidades acreditadas en Ecuador</p>
      <ul class="mt-4 flex flex-wrap items-center justify-center gap-x-8 gap-y-2 text-sm font-semibold text-ink-soft">
        <li>Security Data</li><li>Banco Central del Ecuador</li><li>Consejo de la Judicatura</li><li>ANF</li><li>FirmaSegura</li>
      </ul>
      <div class="mx-auto mt-8 grid max-w-3xl gap-4 text-sm sm:grid-cols-3">
        <p class="flex items-center justify-center gap-2 text-ink-soft"><Icon name="check-circle" size={18} class="text-valid" /> Firmas PAdES estándar</p>
        <p class="flex items-center justify-center gap-2 text-ink-soft"><Icon name="check-circle" size={18} class="text-valid" /> Validadas en FirmaEC y Adobe</p>
        <p class="flex items-center justify-center gap-2 text-ink-soft"><Icon name="check-circle" size={18} class="text-valid" /> Todo en tu computadora</p>
      </div>
    </div>
  </section>

  <!-- ── Cómo funciona ────────────────────────────────────────────────── -->
  <section id="como-funciona" class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-24">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-bold tracking-[-0.02em] sm:text-4xl">Tres pasos, sin configuraciones</h2>
      <p class="mt-4 text-lg leading-8">Configuras tu certificado una sola vez. Desde ahí, firmar un documento es cuestión de segundos.</p>
    </div>
    <ol class="mt-12 grid gap-6 md:grid-cols-3">
      {pasos.map((p) => (
        <li class="rounded-2xl border border-line bg-white p-6">
          <span class="flex h-9 w-9 items-center justify-center rounded-full bg-brand-tint text-sm font-bold text-brand">{p.n}</span>
          <h3 class="mt-5 text-lg font-semibold">{p.titulo}</h3>
          <p class="mt-2 leading-7">{p.texto}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- ── Capturas: Inicio y Verificar ─────────────────────────────────── -->
  <section class="bg-mist">
    <div class="mx-auto max-w-6xl space-y-20 px-5 py-20 sm:px-8 sm:py-24 lg:space-y-28">
      <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-14">
        <div>
          <h2 class="text-3xl font-bold tracking-[-0.02em]">Tu perfil de firma queda guardado</h2>
          <p class="mt-4 text-lg leading-8">
            Certificado, lugar y sello viven en un perfil. Eliges con cuál firmas, sueltas el PDF y ya.
            Tus firmados recientes quedan a un clic para abrirlos, compartirlos o encontrarlos en su carpeta.
          </p>
          <ul class="mt-6 space-y-3">
            <li class="flex gap-3"><Icon name="check" size={20} class="mt-1 shrink-0 text-brand" /> Un perfil para ti y otro para tu empresa</li>
            <li class="flex gap-3"><Icon name="check" size={20} class="mt-1 shrink-0 text-brand" /> Contraseña recordada, cifrada en tu equipo</li>
            <li class="flex gap-3"><Icon name="check" size={20} class="mt-1 shrink-0 text-brand" /> Historial de documentos firmados con búsqueda</li>
          </ul>
        </div>
        <div class="app-shot">
          <img src="/screenshots/app-inicio.webp" width="2000" height="1250" loading="lazy"
            alt="Pantalla de Inicio de Penké: selector de perfil, zona para arrastrar el PDF y lista de documentos firmados recientemente." />
        </div>
      </div>

      <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-14">
        <div class="app-shot lg:order-first">
          <img src="/screenshots/app-verificar.webp" width="2000" height="1250" loading="lazy"
            alt="Pantalla Verificar PDF firmado de Penké: dos firmas válidas y el aviso de que el documento no fue modificado después de firmarse." />
        </div>
        <div class="order-first lg:order-none">
          <h2 class="text-3xl font-bold tracking-[-0.02em]">Verifica cualquier PDF firmado</h2>
          <p class="mt-4 text-lg leading-8">
            Comprueba quién firmó, con qué certificado y si el documento cambió después de firmarse.
            También puedes revisar si un certificado está vigente o fue revocado.
          </p>
          <ul class="mt-6 space-y-3">
            <li class="flex gap-3"><Icon name="check" size={20} class="mt-1 shrink-0 text-brand" /> Todas las firmas del documento, una por una</li>
            <li class="flex gap-3"><Icon name="check" size={20} class="mt-1 shrink-0 text-brand" /> Consulta de revocación con la entidad emisora</li>
            <li class="flex gap-3"><Icon name="check" size={20} class="mt-1 shrink-0 text-brand" /> Explicaciones claras cuando algo no está bien</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Funciones ────────────────────────────────────────────────────── -->
  <section id="funciones" class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-24">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-bold tracking-[-0.02em] sm:text-4xl">Pensado para el trabajo de todos los días</h2>
      <p class="mt-4 text-lg leading-8">Contratos, actas, informes y facturas: Penké se adapta al documento, no al revés.</p>
    </div>
    <div class="mt-12 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
      {funciones.map((f) => (
        <div class="bg-white p-7">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-tint text-brand"><Icon name={f.icono} size={20} /></span>
          <h3 class="mt-5 text-base font-semibold">{f.titulo}</h3>
          <p class="mt-2 leading-7">{f.texto}</p>
        </div>
      ))}
    </div>

    <div class="mt-20 rounded-2xl border border-line p-7 sm:p-10">
      <h2 class="text-2xl font-bold tracking-[-0.02em]">¿Vienes de la aplicación oficial?</h2>
      <div class="mt-6 overflow-hidden rounded-xl border border-line">
        <div class="hidden grid-cols-2 bg-mist text-xs font-semibold uppercase tracking-wider text-ink-muted sm:grid">
          <p class="px-5 py-3">Antes</p><p class="border-l border-line px-5 py-3">Con Penké</p>
        </div>
        {comparacion.map(([antes, ahora]) => (
          <div class="grid border-t border-line first:border-t-0 sm:grid-cols-2 sm:first:border-t">
            <p class="px-5 pt-4 text-ink-muted sm:py-4"><span class="sr-only">Antes: </span>{antes}</p>
            <p class="flex gap-2 px-5 pb-4 pt-1 font-semibold text-ink sm:border-l sm:border-line sm:py-4">
              <Icon name="check" size={20} class="mt-0.5 shrink-0 text-valid" /><span><span class="sr-only">Con Penké: </span>{ahora}</span>
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Privacidad ───────────────────────────────────────────────────── -->
  <section id="privacidad" class="border-y border-line bg-mist">
    <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-24">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-bold tracking-[-0.02em] sm:text-4xl">Tus documentos no salen de tu computadora</h2>
        <p class="mt-4 text-lg leading-8">Penké firma en tu equipo. Sin cuentas, sin nube y sin letra pequeña sobre qué se conecta a internet.</p>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        <div class="rounded-2xl border border-line bg-white p-7">
          <p class="flex items-center gap-3 font-semibold text-ink"><span class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-tint text-brand"><Icon name="lock" size={18} /></span>Se queda en tu equipo</p>
          <ul class="mt-5 space-y-3">
            <li class="flex gap-3"><Icon name="check" size={20} class="mt-1 shrink-0 text-valid" /> Tus documentos PDF</li>
            <li class="flex gap-3"><Icon name="check" size={20} class="mt-1 shrink-0 text-valid" /> Tu certificado y tu clave privada</li>
            <li class="flex gap-3"><Icon name="check" size={20} class="mt-1 shrink-0 text-valid" /> Tu contraseña, cifrada si eliges recordarla</li>
            <li class="flex gap-3"><Icon name="check" size={20} class="mt-1 shrink-0 text-valid" /> Tus perfiles e historial de firmas</li>
          </ul>
        </div>
        <div class="rounded-2xl border border-line bg-white p-7">
          <p class="flex items-center gap-3 font-semibold text-ink"><span class="flex h-9 w-9 items-center justify-center rounded-lg bg-mist text-ink-soft"><Icon name="wifi" size={18} /></span>Lo único que usa internet</p>
          <ul class="mt-5 space-y-3">
            <li class="flex gap-3"><Icon name="globe" size={18} class="mt-1 shrink-0 text-ink-muted" /> La consulta a tu entidad de certificación para saber si el certificado fue revocado</li>
            <li class="flex gap-3"><Icon name="globe" size={18} class="mt-1 shrink-0 text-ink-muted" /> La búsqueda de actualizaciones de Penké</li>
            <li class="flex gap-3"><Icon name="globe" size={18} class="mt-1 shrink-0 text-ink-muted" /> Si activas el QR verificable, los datos del sello, nunca el documento</li>
          </ul>
        </div>
      </div>
      <a href="/privacidad" class="mt-8 inline-flex items-center gap-2 font-semibold text-brand hover:text-brand-dark">
        Lee la política de privacidad <Icon name="arrow-right" size={16} />
      </a>
    </div>
  </section>

  <!-- ── Preguntas ────────────────────────────────────────────────────── -->
  <section id="preguntas" class="mx-auto max-w-3xl px-5 py-20 sm:px-8 sm:py-24">
    <h2 class="text-3xl font-bold tracking-[-0.02em] sm:text-4xl">Preguntas frecuentes</h2>
    <div class="faq mt-10 divide-y divide-line border-y border-line">
      {preguntas.map((p) => (
        <details class="group">
          <summary class="flex items-start justify-between gap-6 py-5 text-left text-base font-semibold text-ink hover:text-brand">
            {p.q}
            <Icon name="plus" size={20} class="faq-plus mt-0.5 shrink-0 text-ink-muted" />
          </summary>
          <p class="max-w-[65ch] pb-6 leading-7">{p.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ── Descargar ────────────────────────────────────────────────────── -->
  <section id="descargar" class="bg-brand-deep text-white">
    <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-24">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-[-0.02em] text-white sm:text-4xl">Descarga Penké gratis</h2>
        <p class="mt-4 text-lg leading-8 text-blue-100">
          Sin suscripciones ni límites de uso{version && <>. Versión {version}</>}.
        </p>
      </div>

      <div class="mx-auto mt-12 grid max-w-5xl gap-5 md:grid-cols-3">
        <div class="flex flex-col rounded-2xl bg-white p-7 text-ink-soft" data-os="windows">
          <svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true" class="text-ink"><path fill="currentColor" d="M3 5.1 10.4 4v7.1H3zm0 13.8V12h7.4v7.1zM11.3 3.9 21 2.5v8.6h-9.7zM21 21.5l-9.7-1.4V12H21z"/></svg>
          <h3 class="mt-4 text-lg font-semibold">Windows</h3>
          <p class="mt-1 text-sm">Windows 10 y 11 · instalador .exe</p>
          <a href="/descargar?os=windows" class="mt-6 inline-flex h-11 items-center justify-center gap-2 rounded-xl bg-brand px-5 font-semibold text-white hover:bg-brand-dark">
            <Icon name="download" size={18} /> Descargar para Windows
          </a>
        </div>

        <div class="flex flex-col rounded-2xl bg-white p-7 text-ink-soft" data-os="mac">
          <svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true" class="text-ink"><path fill="currentColor" d="M16.37 12.6c-.02-2.2 1.8-3.26 1.88-3.31-1.02-1.5-2.62-1.7-3.19-1.72-1.36-.14-2.65.8-3.34.8-.69 0-1.75-.78-2.88-.76-1.48.02-2.85.86-3.61 2.19-1.54 2.67-.39 6.62 1.11 8.79.73 1.06 1.61 2.25 2.76 2.2 1.1-.04 1.52-.71 2.86-.71 1.33 0 1.71.71 2.88.69 1.19-.02 1.94-1.08 2.67-2.14.84-1.23 1.19-2.42 1.21-2.48-.03-.01-2.32-.89-2.35-3.55M14.17 6.12c.61-.74 1.02-1.76.91-2.78-.88.04-1.94.59-2.57 1.32-.56.65-1.06 1.69-.93 2.69.98.08 1.98-.5 2.59-1.23"/></svg>
          <h3 class="mt-4 text-lg font-semibold">macOS</h3>
          <p class="mt-1 text-sm">Apple Silicon e Intel · archivo .dmg</p>
          <a href="/descargar?os=mac" class="mt-6 inline-flex h-11 items-center justify-center gap-2 rounded-xl bg-brand px-5 font-semibold text-white hover:bg-brand-dark">
            <Icon name="download" size={18} /> Descargar para macOS
          </a>
          <p class="mt-4 text-xs leading-5 text-ink-muted">La primera vez que lo abras, haz clic derecho sobre Penké y elige <strong class="font-semibold text-ink-soft">Abrir</strong>.</p>
        </div>

        <div class="flex flex-col rounded-2xl bg-white p-7 text-ink-soft" data-os="linux">
          <span class="text-ink"><Icon name="terminal" size={28} /></span>
          <h3 class="mt-4 text-lg font-semibold">Linux</h3>
          <p class="mt-1 text-sm">Ubuntu, Debian, Fedora y derivados</p>
          <a href="/descargar?os=deb" class="mt-6 inline-flex h-11 items-center justify-center gap-2 rounded-xl bg-brand px-5 font-semibold text-white hover:bg-brand-dark">
            <Icon name="download" size={18} /> Descargar .deb
          </a>
          <a href="/descargar?os=rpm" class="mt-3 inline-flex h-11 items-center justify-center gap-2 rounded-xl border border-line px-5 font-semibold text-ink hover:bg-mist">
            Descargar .rpm
          </a>
        </div>
      </div>
    </div>
  </section>

  <script>
    // El botón principal ofrece el instalador del sistema del visitante
    const nav = navigator as Navigator & { userAgentData?: { platform?: string } };
    const plataforma = (nav.userAgentData?.platform || navigator.platform || navigator.userAgent).toLowerCase();
    const agente = navigator.userAgent.toLowerCase();
    // En un teléfono no se instala: el botón lleva a las opciones de descarga
    const sistema = /android|iphone|ipad|mobile/.test(agente) ? "movil"
      : /mac/.test(plataforma) ? "mac"
      : /linux|x11/.test(plataforma) ? "linux"
      : "windows";
    const destinos = {
      windows: { href: "/descargar?os=windows", texto: "Descargar para Windows" },
      mac: { href: "/descargar?os=mac", texto: "Descargar para macOS" },
      linux: { href: "/descargar?os=deb", texto: "Descargar para Linux" },
      movil: { href: "#descargar", texto: "Ver descargas" },
    } as const;
    const boton = document.querySelector<HTMLAnchorElement>("[data-descarga-principal]");
    const texto = document.querySelector("[data-descarga-texto]");
    if (boton && texto) {
      boton.href = destinos[sistema].href;
      texto.textContent = destinos[sistema].texto;
    }
    // La tarjeta del sistema del visitante se resalta
    document.querySelector(`[data-os="${sistema}"]`)?.classList.add("ring-4", "ring-blue-300");
  </script>
</Base>
