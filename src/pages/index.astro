---
import "../styles/global.css";

const bentoFeatures = [
  {
    title: "Onboarding automático sin manuales",
    desc: "Configura tu archivo .p12 o Token USB en 3 pasos asistidos. Detecta automáticamente las entidades de certificación acreditadas de Ecuador.",
    tag: "Listo en 1 minuto",
    badgeBg: "bg-blue-50 text-blue-700 border-blue-200",
    image: "/screenshots/onboarding.png",
    colSpan: "md:col-span-2",
    highlight: true,
  },
  {
    title: "Visor PDF con estampa visual",
    desc: "Visualiza el documento antes de firmar y arrastra tu estampa visual exactamente a la página y coordenada requerida.",
    icon: "pdf",
    colSpan: "md:col-span-1",
  },
  {
    title: "Soporte Token USB",
    desc: "Conecta tu token físico de firma (Security Data, BCE, Consejo de la Judicatura, ANF) y Penké lo reconoce solo, sin drivers adicionales.",
    icon: "usb",
    colSpan: "md:col-span-1",
  },
  {
    title: "Procesamiento de firma en lote",
    desc: "Firma carpetas completas de archivos PDF de facturación, contratos o trámites gubernamentales en un solo clic.",
    icon: "batch",
    colSpan: "md:col-span-1",
  },
  {
    title: "Localización Ecuador integrada",
    desc: "Autocomplete nativo con la división política oficial (provincias, cantones y parroquias) para la razón de firma.",
    icon: "geo",
    colSpan: "md:col-span-1",
  },
];

const faqs = [
  {
    q: "¿Por qué no tengo que instalar Java por mi cuenta?",
    a: "Penké ya trae todo lo que necesita incluido. Descargas un solo instalador, lo abres, y queda listo para firmar — sin pasos adicionales ni programas sueltos que buscar."
  },
  {
    q: "¿Es compatible con mis certificados de Banco Central, Judicatura o Security Data?",
    a: "Sí. Penké reconoce automáticamente los certificados emitidos por las entidades acreditadas en Ecuador y confirma que sigan vigentes antes de dejarte firmar."
  },
  {
    q: "¿Mis documentos o mi contraseña se envían a algún servidor?",
    a: "Absolutamente no. Todo el proceso de firma, validación y verificación ocurre dentro de tu computadora. Ningún PDF ni tu clave privada (.p12) sale de tu equipo."
  },
  {
    q: "¿Tiene algún costo o límite de uso?",
    a: "Ninguno. Penké es software libre y de código abierto. Es completamente gratuito para uso personal, profesional o gubernamental."
  },
  {
    q: "¿Cómo revisa Penké que mi certificado sea válido?",
    a: "Penké confirma que tu certificado esté vigente, que te pertenezca a ti (o a tu empresa) y que la entidad que lo emitió esté acreditada en Ecuador — todo antes de dejarte firmar."
  }
];
---
<!doctype html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Penké — Firma digital de PDFs en Ecuador sin complicaciones</title>
  <meta name="description" content="Aplicación de escritorio gratuita para firmar, verificar y validar PDFs con tu certificado digital ecuatoriano (.p12 o Token USB). Sin instalar Java. 100% gratuita y de código abierto." />
  <meta property="og:title" content="Penké — Firma digital de PDFs en Ecuador sin complicaciones" />
  <meta property="og:description" content="Adiós a los errores de Java. Firma documentos PDF con tu certificado digital ecuatoriano en segundos." />
  <meta property="og:image" content="/screenshots/home.jpg" />
  <link rel="icon" type="image/png" href="/brand/penke-app-icon.png" />
  <noscript>
    <style>.reveal { opacity: 1 !important; transform: none !important; }</style>
  </noscript>
</head>
<body class="bg-white text-slate-900 antialiased selection:bg-blue-100 selection:text-blue-900">

  <!-- ═══════════════════════════════ HEADER ═══════════════════════════════ -->
  <header id="navbar" class="fixed top-0 left-0 right-0 z-50 border-b border-transparent transition-all duration-200">
    <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between gap-6">
      <a href="#" class="flex items-center gap-3 font-bold text-slate-900 text-lg group">
        <div class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center text-white shadow-md shadow-blue-500/20 group-hover:scale-105 transition-transform">
          <svg width="20" height="20" viewBox="0 0 512 512" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path d="M142 430V128C142 84 172 58 222 58H260C348 58 402 105 402 176C402 248 347 294 260 294H142V430C190 408 232 398 272 402C307 406 335 421 362 447" stroke="white" stroke-width="44"/>
            <path d="M318 186L350 218L418 142" stroke="#0E8F79" stroke-width="38"/>
          </svg>
        </div>
        <span class="tracking-tight">Penké</span>
        <span class="text-[11px] font-semibold text-slate-700 bg-slate-100 px-2 py-0.5 rounded-full border border-slate-200">Open Source</span>
      </a>

      <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-600">
        <a href="#caracteristicas" class="hover:text-slate-900 transition-colors">Funciones</a>
        <a href="#capturas" class="hover:text-slate-900 transition-colors">Vista Previa</a>
        <a href="#arquitectura" class="hover:text-slate-900 transition-colors">Privacidad</a>
        <a href="#faq" class="hover:text-slate-900 transition-colors">FAQ</a>
      </nav>

      <div class="flex items-center gap-2">
        <a href="https://github.com/CharlieCardenasToledo/penke-ec" target="_blank" rel="noopener"
          class="hidden sm:inline-flex items-center gap-2 px-3.5 py-1.5 rounded-lg border border-slate-200 text-slate-700 text-xs font-semibold hover:bg-slate-50 transition-colors">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          Código fuente
        </a>
        <a href="#descargar"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-600/90 text-white font-bold text-sm shadow-lg shadow-blue-600/25 transition-all hover:-translate-y-0.5">
          Obtener Penké
        </a>
        <button id="mobile-menu-btn" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu"
          class="md:hidden inline-flex items-center justify-center w-11 h-11 -mr-1 rounded-lg text-slate-600 hover:bg-slate-100 transition-colors">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="4" y1="7" x2="20" y2="7" id="mm-line-1"/>
            <line x1="4" y1="12" x2="20" y2="12" id="mm-line-2"/>
            <line x1="4" y1="17" x2="20" y2="17" id="mm-line-3"/>
          </svg>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="hidden md:hidden bg-white border-b border-slate-200 shadow-sm">
      <nav class="flex flex-col px-6 py-3 text-sm font-semibold text-slate-700">
        <a href="#caracteristicas" class="py-3 border-b border-slate-100">Funciones</a>
        <a href="#capturas" class="py-3 border-b border-slate-100">Vista Previa</a>
        <a href="#arquitectura" class="py-3 border-b border-slate-100">Privacidad</a>
        <a href="#faq" class="py-3">FAQ</a>
      </nav>
    </div>
  </header>

  <!-- ═══════════════════════════════ HERO ════════════════════════════════ -->
  <section class="pt-32 pb-16 md:pt-40 md:pb-24 bg-gradient-to-b from-slate-50 to-white border-b border-slate-100">
    <div class="max-w-6xl mx-auto px-6">

      <div class="max-w-3xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-50 border border-blue-200/80 text-blue-800 text-xs font-semibold mb-6">
          <span class="flex h-2 w-2 rounded-full bg-emerald-500"></span>
          Compatible con tu certificado de FirmaEC
        </div>

        <h1 class="text-4xl sm:text-5xl md:text-6xl font-black tracking-tight text-slate-900 leading-[1.1] mb-6">
          Firma digital de PDFs en Ecuador, <span class="penke-teal">sin los dolores de Java.</span>
        </h1>

        <p class="text-slate-600 text-base sm:text-lg leading-relaxed mb-8 max-w-xl mx-auto">
          Penké empaqueta todo lo necesario para firmar en una sola app, lista para usar.
          Usa tu certificado <strong>.p12</strong> o tu <strong>Token USB</strong> sin errores de configuración.
        </p>

        <div class="flex flex-col items-center gap-3 mb-10">
          <a href="https://github.com/CharlieCardenasToledo/penke-ec/releases" target="_blank" rel="noopener"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-7 py-3.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm shadow-xl shadow-blue-600/25 transition-all hover:-translate-y-0.5">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            Descargar Penké gratis
          </a>
          <p class="text-xs text-slate-500">Disponible para Windows. macOS y Linux, muy pronto.</p>
        </div>

        <div class="pt-2 border-t border-slate-200/60 max-w-lg mx-auto flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-xs text-slate-500 font-medium">
          <span>Compatible con:</span>
          <span class="font-semibold text-slate-700">Banco Central (BCE)</span>
          <span>•</span>
          <span class="font-semibold text-slate-700">Security Data</span>
          <span>•</span>
          <span class="font-semibold text-slate-700">Consejo Judicatura</span>
        </div>
      </div>

      <!-- DESKTOP SCREENSHOT SHOWCASE -->
      <div class="mt-14 max-w-5xl mx-auto reveal">
        <div class="desktop-window">
          <div class="bg-slate-100 px-4 py-2.5 border-b border-slate-200 flex items-center justify-between select-none">
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-full bg-red-400"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
              <div class="w-3 h-3 rounded-full bg-green-400"></div>
            </div>
            <div class="text-xs font-semibold text-slate-600">Penké — Firma digital sin complicaciones</div>
            <div class="inline-flex items-center gap-1 text-[11px] font-semibold text-slate-600">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              100% local
            </div>
          </div>
          <div class="bg-slate-900 aspect-[16/10] overflow-hidden">
            <img src="/screenshots/home.jpg" alt="Interfaz principal de Penké" class="w-full h-full object-cover object-top" loading="eager" />
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ════════════════════════ BENTO GRID FUNCIONAL ════════════════════════ -->
  <section class="py-20 bg-white" id="caracteristicas">
    <div class="max-w-6xl mx-auto px-6">

      <div class="max-w-2xl mb-14 reveal">
        <p class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-snug">
          Sin configuraciones complejas. Solo abre, arrastra y firma.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

        <!-- Card Onboarding (Wide) -->
        <div class="md:col-span-2 bg-slate-50 border border-slate-200 rounded-2xl p-7 md:p-8 flex flex-col md:flex-row gap-8 items-center justify-between hover:border-blue-300 transition-all reveal">
          <div class="flex-1 space-y-3">
            <div class="inline-flex items-center gap-1.5 text-xs font-bold px-3 py-1 rounded-full bg-blue-100 text-blue-700">
              Paso a paso guiado
            </div>
            <h3 class="text-xl font-bold text-slate-900">Onboarding asistido de certificados</h3>
            <p class="text-slate-600 text-sm leading-relaxed">
              Olvídate de buscar contraseñas o instalar programas sueltos. Penké detecta el tipo de certificado, valida la contraseña y configura tu firma en segundos.
            </p>
          </div>
          <div class="w-full md:w-56 shrink-0 rounded-xl overflow-hidden shadow-md border border-slate-200 bg-white">
            <img src="/screenshots/onboarding.png" alt="Onboarding guiado" class="w-full h-auto object-cover" loading="lazy" />
          </div>
        </div>

        <!-- Visor PDF -->
        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6 flex flex-col justify-between hover:border-blue-300 transition-all reveal">
          <div class="w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center mb-4 font-bold">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          </div>
          <div>
            <h3 class="text-base font-bold text-slate-900 mb-2">Visor PDF con estampa visual</h3>
            <p class="text-slate-600 text-xs leading-relaxed">
              Inspecciona el documento completo antes de firmar. Elige la página y ubica tu firma exactamente donde la requiera la institución.
            </p>
          </div>
        </div>

        <!-- Token USB -->
        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6 flex flex-col justify-between hover:border-blue-300 transition-all reveal">
          <div class="w-10 h-10 rounded-xl bg-emerald-600 text-white flex items-center justify-center mb-4 font-bold">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="2" width="6" height="10" rx="1"/><path d="M12 12v4m-3 4h6"/></svg>
          </div>
          <div>
            <h3 class="text-base font-bold text-slate-900 mb-2">Soporte nativo Token USB</h3>
            <p class="text-slate-600 text-xs leading-relaxed">
              Conecta tu dispositivo de firma y Penké lo reconoce de inmediato, sin instalar nada adicional en tu navegador.
            </p>
          </div>
        </div>

        <!-- Firma Masiva -->
        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6 flex flex-col justify-between hover:border-blue-300 transition-all reveal">
          <div class="w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center mb-4 font-bold">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
          </div>
          <div>
            <h3 class="text-base font-bold text-slate-900 mb-2">Procesamiento masivo en lote</h3>
            <p class="text-slate-600 text-xs leading-relaxed">
              Ideal para contadores y despachos legales: selecciona varios PDFs y fírmalos todos en segundos.
            </p>
          </div>
        </div>

        <!-- Localización -->
        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6 flex flex-col justify-between hover:border-blue-300 transition-all reveal">
          <div class="w-10 h-10 rounded-xl bg-emerald-600 text-white flex items-center justify-center mb-4 font-bold">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="10" r="3"/><path d="M12 2a8 8 0 0 1 8 8c0 5.25-8 14-8 14S4 15.25 4 10a8 8 0 0 1 8-8z"/></svg>
          </div>
          <div>
            <h3 class="text-base font-bold text-slate-900 mb-2">Localización Ecuador integrada</h3>
            <p class="text-slate-600 text-xs leading-relaxed">
              Provincias, cantones y parroquias listos para autocompletar la ubicación del firmante, sin escribir nada a mano.
            </p>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- ════════════════════════ INTERFACE VIEWER (TABS) ════════════════════════ -->
  <section class="py-20 bg-slate-900 text-white" id="capturas">
    <div class="max-w-6xl mx-auto px-6">

      <div class="text-center max-w-2xl mx-auto mb-10 reveal">
        <p class="text-3xl font-extrabold tracking-tight">Así se ve firmar con Penké</p>
      </div>

      <div class="flex justify-center gap-2 mb-8 flex-wrap" id="screen-tabs">
        <button data-tab="home" class="screen-tab px-4 py-3.5 rounded-lg text-xs font-bold border border-blue-500 bg-blue-600 text-white transition-all cursor-pointer">
          Firma rápida
        </button>
        <button data-tab="firmar" class="screen-tab px-4 py-3.5 rounded-lg text-xs font-bold border border-slate-700 bg-slate-800 text-slate-300 hover:text-white transition-all cursor-pointer">
          Mis firmas
        </button>
        <button data-tab="verificar" class="screen-tab px-4 py-3.5 rounded-lg text-xs font-bold border border-slate-700 bg-slate-800 text-slate-300 hover:text-white transition-all cursor-pointer">
          Verificador de PDF
        </button>
        <button data-tab="validar" class="screen-tab px-4 py-3.5 rounded-lg text-xs font-bold border border-slate-700 bg-slate-800 text-slate-300 hover:text-white transition-all cursor-pointer">
          Validador de certificado
        </button>
      </div>

      <div class="max-w-5xl mx-auto reveal">
        <div class="desktop-window-dark">
          <div class="bg-slate-950 px-4 py-2 border-b border-slate-800 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-full bg-red-400"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
              <div class="w-3 h-3 rounded-full bg-green-400"></div>
            </div>
            <span id="tab-title-display" class="text-xs font-semibold text-slate-400">Firma rápida</span>
            <span></span>
          </div>

          <div class="aspect-[16/10] overflow-hidden bg-slate-900">
            <div data-panel="home" class="screen-panel h-full">
              <img src="/screenshots/home.jpg" alt="Firma rápida" class="w-full h-full object-cover object-top" />
            </div>
            <div data-panel="firmar" class="screen-panel hidden h-full">
              <img src="/screenshots/firmar.jpg" alt="Mis firmas" class="w-full h-full object-cover object-top" />
            </div>
            <div data-panel="verificar" class="screen-panel hidden h-full">
              <img src="/screenshots/verificar.jpg" alt="Verificador de firmas PDF" class="w-full h-full object-cover object-top" />
            </div>
            <div data-panel="validar" class="screen-panel hidden h-full">
              <img src="/screenshots/validar.jpg" alt="Validador de certificados .p12" class="w-full h-full object-cover object-top" />
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ════════════════════ PRIVACIDAD Y DIFERENCIA ════════════════════ -->
  <section class="py-20 bg-slate-50 border-y border-slate-200" id="arquitectura">
    <div class="max-w-5xl mx-auto px-6">

      <div class="bg-white border border-slate-200 rounded-3xl p-8 sm:p-12 shadow-sm reveal">
        <div class="max-w-3xl">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mb-4">
            Tus archivos y tu clave privada nunca salen de tu computadora
          </h2>
          <p class="text-slate-600 text-sm sm:text-base leading-relaxed mb-6 max-w-[62ch]">
            Todo el proceso de firma ocurre dentro de tu equipo. Ni tu documento ni tu contraseña se envían a ningún servidor, ni siquiera al nuestro.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 pt-6 border-t border-slate-100">
          <div>
            <div class="text-xs font-semibold text-slate-500 mb-2 uppercase tracking-wide">La app oficial</div>
            <p class="text-sm text-slate-600 leading-relaxed">Necesitas instalar Java y el driver de tu token por separado, y alternar entre el navegador y programas aparte según el trámite.</p>
          </div>
          <div>
            <div class="text-xs font-semibold text-penke-teal mb-2 uppercase tracking-wide">Penké</div>
            <p class="text-sm text-slate-900 font-semibold leading-relaxed">Un solo instalador. Una sola app de escritorio. Ábrela y firma.</p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════ FAQ ══════════════════════════════════ -->
  <section class="py-20 bg-white" id="faq">
    <div class="max-w-3xl mx-auto px-6">

      <div class="text-center mb-12 reveal">
        <p class="text-3xl font-extrabold text-slate-900">Preguntas frecuentes</p>
      </div>

      <div class="space-y-4 reveal">
        {faqs.map((item, i) => (
          <div class="faq-item border border-slate-200 rounded-xl overflow-hidden bg-slate-50/50">
            <button class="faq-btn w-full flex justify-between items-center p-5 text-left font-bold text-slate-900 hover:text-penke-blue transition-colors text-sm cursor-pointer">
              <span>{item.q}</span>
              <span class="faq-icon text-slate-400 text-lg font-light shrink-0 ml-4">+</span>
            </button>
            <div class="faq-answer overflow-hidden max-h-0 transition-all duration-300 bg-white px-5">
              <p class="py-4 text-xs sm:text-sm text-slate-600 leading-relaxed border-t border-slate-100 max-w-[68ch]">{item.a}</p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

