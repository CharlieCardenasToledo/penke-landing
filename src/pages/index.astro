---
import "../styles/global.css";

const bentoFeatures = [
  {
    num: "01",
    title: "Arrastra el PDF, coloca tu firma y firma",
    desc: "Sin repetir tu certificado cada vez que abres la app ni navegar carpeta por carpeta buscando el archivo. Tu perfil de firma queda guardado — arrastra el PDF desde donde esté y listo.",
    image: "/screenshots/home.jpg",
    colSpan: "md:col-span-2",
  },
  {
    num: "02",
    title: "Visor PDF con estampa visual",
    desc: "Visualiza el documento antes de firmar y arrastra tu estampa visual exactamente a la página y coordenada requerida.",
    colSpan: "md:col-span-1",
  },
  {
    num: "03",
    title: "Soporte Token USB",
    desc: "Conecta tu token físico de firma (Security Data, BCE, Consejo de la Judicatura, ANF) y Penké lo reconoce solo, sin drivers adicionales.",
    colSpan: "md:col-span-1",
  },
  {
    num: "04",
    title: "Procesamiento de firma en lote",
    desc: "Firma carpetas completas de archivos PDF de facturación, contratos o trámites gubernamentales en un solo clic.",
    colSpan: "md:col-span-1",
  },
  {
    num: "05",
    title: "Localización Ecuador integrada",
    desc: "Autocomplete nativo con la división política oficial (provincias, cantones y parroquias) para la razón de firma.",
    colSpan: "md:col-span-1",
  },
];

const faqs = [
  {
    q: "¿Por qué no tengo que instalar Java por mi cuenta?",
    a: "Penké ya trae todo lo que necesita incluido. Descargas un solo instalador, lo abres, y queda listo para firmar — sin pasos adicionales ni programas sueltos que buscar."
  },
  {
    q: "¿Es compatible con mis certificados de Banco Central, Judicatura o Security Data?",
    a: "Sí. Penké reconoce automáticamente los certificados emitidos por las entidades acreditadas en Ecuador y confirma que sigan vigentes antes de dejarte firmar."
  },
  {
    q: "¿Mis documentos o mi contraseña se envían a algún servidor?",
    a: "Absolutamente no. Todo el proceso de firma, validación y verificación ocurre dentro de tu computadora. Ningún PDF ni tu clave privada (.p12) sale de tu equipo."
  },
  {
    q: "¿Tiene algún costo o límite de uso?",
    a: "Ninguno. Penké es software libre y de código abierto. Es completamente gratuito para uso personal, profesional o gubernamental."
  },
  {
    q: "¿Cómo revisa Penké que mi certificado sea válido?",
    a: "Penké confirma que tu certificado esté vigente, que te pertenezca a ti (o a tu empresa) y que la entidad que lo emitió esté acreditada en Ecuador — todo antes de dejarte firmar."
  }
];
---
<!doctype html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Penké — Firma digital de PDFs en Ecuador sin complicaciones</title>
  <meta name="description" content="Aplicación de escritorio gratuita para firmar, verificar y validar PDFs con tu certificado digital ecuatoriano (.p12 o Token USB). Sin pasos técnicos ni programas adicionales. 100% gratuita y de código abierto." />
  <meta property="og:title" content="Penké — Firma digital de PDFs en Ecuador sin complicaciones" />
  <meta property="og:description" content="Adiós a las instalaciones complicadas. Firma documentos PDF con tu certificado digital ecuatoriano en segundos." />
  <meta property="og:image" content="/screenshots/home.jpg" />
  <link rel="icon" type="image/png" href="/brand/penke-app-icon.png" />
  <noscript>
    <style>.reveal { opacity: 1 !important; transform: none !important; }</style>
  </noscript>
</head>
<body class="bg-white text-slate-900 antialiased selection:bg-blue-100 selection:text-blue-900">
<!--
THESIS: Firmar con Penké se siente como recibir un certificado real, no
como llenar un formulario web — la página misma es el documento.
OWN-WORLD: grabado tipo guilloché en teal sobre campos sólidos de azul
marino (nunca papel/crema), sello circular con el isotipo, marcas de
registro de imprenta en las esquinas de cada marco, serif Alegreya para
titulares, Public Sans para cuerpo, JetBrains Mono para datos verificables.
STORY: un profesional ecuatoriano cansado de recargar su certificado y
buscar PDFs carpeta por carpeta en la app oficial ve que Penké tiene el
peso de algo oficial, entiende que solo debe arrastrar y firmar, y
descarga sin dudar.
FIRST VIEWPORT: campo azul marino a pantalla completa, sello centrado
sobre el titular en Alegreya que demuestra el mecanismo (arrastrar,
colocar firma, firmar), cinta de seguridad teal en la esquina superior
derecha, CTA teal, mockup en marco de certificado debajo.
FORM: Certificado de autenticidad — candidato 3 de la lista propia,
seed key c4864dca; raise donado por el especimen tipográfico (jerarquía
por escala) y por el título Saul Bass (campos de color comprometidos).
FINISH: unreviewed and undocumented is unfinished; this build ends with
the finish review, the verdict, DESIGN.md, and every shipping raster
carrying its provenance.
-->

  <!-- Reusable SVG defs: guilloché engraving pattern + seal emblem -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs>
      <pattern id="guilloche" width="46" height="46" patternUnits="userSpaceOnUse">
        <circle cx="23" cy="23" r="20" fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.55"/>
        <circle cx="23" cy="23" r="13" fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.45"/>
        <circle cx="0" cy="0" r="20" fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.35"/>
        <circle cx="46" cy="46" r="20" fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.35"/>
        <circle cx="46" cy="0" r="20" fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.35"/>
        <circle cx="0" cy="46" r="20" fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.35"/>
      </pattern>
      <symbol id="penke-seal" viewBox="0 0 200 200">
        <circle cx="100" cy="100" r="94" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="1.5 7"/>
        <circle cx="100" cy="100" r="82" fill="none" stroke="currentColor" stroke-width="1.2"/>
        <circle cx="100" cy="100" r="72" fill="#ffffff"/>
        <g transform="translate(16,24) scale(0.3)">
          <path d="M142 430V128C142 84 172 58 222 58H260C348 58 402 105 402 176C402 248 347 294 260 294H142V430C190 408 232 398 272 402C307 406 335 421 362 447" fill="none" stroke="#2563EB" stroke-width="44" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M318 186L350 218L418 142" fill="none" stroke="#0E8F79" stroke-width="38" stroke-linecap="round" stroke-linejoin="round"/>
        </g>
      </symbol>
    </defs>
  </svg>

  <!-- ═══════════════════════════════ HEADER ═══════════════════════════════ -->
  <header id="navbar" class="fixed top-0 left-0 right-0 z-50 border-b border-transparent transition-all duration-200">
    <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between gap-6">
      <a href="#" class="flex items-center gap-2.5 font-bold text-slate-900 group">
        <div class="w-8 h-8 rounded-full bg-penke-dark flex items-center justify-center text-white shadow-md shadow-slate-900/20 group-hover:scale-105 transition-transform">
          <svg width="18" height="18" viewBox="0 0 512 512" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path d="M142 430V128C142 84 172 58 222 58H260C348 58 402 105 402 176C402 248 347 294 260 294H142V430C190 408 232 398 272 402C307 406 335 421 362 447" stroke="white" stroke-width="44"/>
            <path d="M318 186L350 218L418 142" stroke="#0E8F79" stroke-width="38"/>
          </svg>
        </div>
        <span class="font-serif text-xl tracking-tight">Penké</span>
        <span class="text-[10px] font-semibold text-slate-600 bg-slate-100 px-2 py-0.5 rounded-full border border-slate-200 uppercase tracking-wider">Open Source</span>
      </a>

      <nav class="hidden md:flex items-center gap-6 text-[13px] font-semibold text-slate-600 uppercase tracking-wide">
        <a href="#caracteristicas" class="hover:text-slate-900 transition-colors">Funciones</a>
        <a href="#capturas" class="hover:text-slate-900 transition-colors">Vista previa</a>
        <a href="#arquitectura" class="hover:text-slate-900 transition-colors">Privacidad</a>
        <a href="#faq" class="hover:text-slate-900 transition-colors">FAQ</a>
      </nav>

      <div class="flex items-center gap-2">
        <a href="https://github.com/CharlieCardenasToledo/penke-ec" target="_blank" rel="noopener"
          class="hidden sm:inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-slate-200 text-slate-700 text-xs font-semibold hover:bg-slate-50 transition-colors">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          Código fuente
        </a>
        <a href="#descargar"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-penke-teal hover:bg-penke-teal-dark text-white font-bold text-sm shadow-lg shadow-teal-900/15 transition-all hover:-translate-y-0.5">
          Obtener Penké
        </a>
        <button id="mobile-menu-btn" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu"
          class="md:hidden inline-flex items-center justify-center w-11 h-11 -mr-1 rounded-lg text-slate-600 hover:bg-slate-100 transition-colors">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="4" y1="7" x2="20" y2="7"/>
            <line x1="4" y1="12" x2="20" y2="12"/>
            <line x1="4" y1="17" x2="20" y2="17"/>
          </svg>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="hidden md:hidden bg-white border-b border-slate-200 shadow-sm">
      <nav class="flex flex-col px-6 py-3 text-sm font-semibold text-slate-700 uppercase tracking-wide">
        <a href="#caracteristicas" class="py-3 border-b border-slate-100">Funciones</a>
        <a href="#capturas" class="py-3 border-b border-slate-100">Vista previa</a>
        <a href="#arquitectura" class="py-3 border-b border-slate-100">Privacidad</a>
        <a href="#faq" class="py-3">FAQ</a>
      </nav>
    </div>
  </header>

  <!-- ═══════════════════════════════ HERO ════════════════════════════════ -->
  <section class="relative pt-32 pb-20 md:pt-40 md:pb-28 bg-penke-dark text-white overflow-hidden">
    <div class="guilloche-ground text-penke-teal">
      <svg width="100%" height="100%"><rect width="100%" height="100%" fill="url(#guilloche)"/></svg>
    </div>
    <div class="security-ribbon" aria-hidden="true"></div>

    <div class="relative max-w-6xl mx-auto px-6">

      <div class="max-w-3xl mx-auto text-center">
        <svg class="w-16 h-16 mx-auto mb-6 text-penke-teal drop-shadow-lg" aria-hidden="true"><use href="#penke-seal" width="64" height="64"/></svg>

        <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight leading-[1.08] mb-6">
          Arrastra tu PDF, coloca tu firma <span class="text-penke-teal italic">y firma. Ya.</span>
        </h1>

        <p class="text-slate-300 text-base sm:text-lg leading-relaxed mb-8 max-w-xl mx-auto">
          Olvídate de cargar tu certificado cada vez que abres la app y de buscar tus PDFs carpeta por carpeta.
          Con Penké tu perfil de firma queda guardado — solo arrastra el archivo desde donde esté.
        </p>

        <div class="flex flex-col items-center gap-3 mb-10">
          <a href="https://github.com/CharlieCardenasToledo/penke-ec/releases" target="_blank" rel="noopener"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-7 py-3.5 rounded-full bg-penke-teal hover:bg-penke-teal-dark text-white font-bold text-sm shadow-xl shadow-black/20 transition-all hover:-translate-y-0.5">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            Descargar Penké gratis
          </a>
          <p class="text-xs text-slate-400 font-medium">Disponible para Windows. macOS y Linux, muy pronto.</p>
        </div>

        <div class="pt-4 border-t border-white/10 max-w-lg mx-auto flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-[11px] text-slate-400 font-semibold uppercase tracking-wide">
          <span>Compatible con:</span>
          <span class="text-slate-200">Banco Central (BCE)</span>
          <span>•</span>
          <span class="text-slate-200">Security Data</span>
          <span>•</span>
          <span class="text-slate-200">Consejo Judicatura</span>
        </div>
      </div>

      <!-- DESKTOP SCREENSHOT — certificate-frame mockup -->
      <div class="mt-14 max-w-5xl mx-auto reveal">
        <div class="cert-frame-dark">
          <svg class="corner-mark tl" viewBox="0 0 20 20" aria-hidden="true"><path d="M2 10H8M10 2V8" stroke="currentColor" stroke-width="1.4" fill="none"/><circle cx="10" cy="10" r="2.6" fill="none" stroke="currentColor" stroke-width="1"/></svg>
          <svg class="corner-mark tr" viewBox="0 0 20 20" aria-hidden="true"><path d="M2 10H8M10 2V8" stroke="currentColor" stroke-width="1.4" fill="none"/><circle cx="10" cy="10" r="2.6" fill="none" stroke="currentColor" stroke-width="1"/></svg>
          <svg class="corner-mark bl" viewBox="0 0 20 20" aria-hidden="true"><path d="M2 10H8M10 2V8" stroke="currentColor" stroke-width="1.4" fill="none"/><circle cx="10" cy="10" r="2.6" fill="none" stroke="currentColor" stroke-width="1"/></svg>
          <svg class="corner-mark br" viewBox="0 0 20 20" aria-hidden="true"><path d="M2 10H8M10 2V8" stroke="currentColor" stroke-width="1.4" fill="none"/><circle cx="10" cy="10" r="2.6" fill="none" stroke="currentColor" stroke-width="1"/></svg>
          <div class="bg-slate-950 px-5 py-2.5 border-b border-white/10 flex items-center justify-between select-none">
            <span class="font-serif text-xs tracking-[0.15em] text-slate-300 uppercase">Penké</span>
            <span class="font-mono text-[10px] text-slate-500 tracking-wide">100% local</span>
          </div>
          <div class="aspect-[1376/768] overflow-hidden">
            <img src="/screenshots/home.jpg" alt="Interfaz principal de Penké" class="w-full h-full object-cover object-top" loading="eager" />
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ════════════════════════ FUNCIONES (clause fields) ═══════════════════ -->
  <section class="py-20 bg-white" id="caracteristicas">
    <div class="max-w-6xl mx-auto px-6">

      <div class="max-w-2xl mb-14 reveal">
        <p class="font-serif text-3xl sm:text-4xl font-semibold text-slate-900 tracking-tight leading-snug">
          Sin configuraciones complejas. Solo abre, arrastra y firma.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-slate-200 border border-slate-200 reveal">

        {bentoFeatures.map((f) => (
          <div class:list={["relative bg-white p-7 md:p-8 flex flex-col gap-3", f.colSpan]}>
            <span class="clause-numeral text-4xl select-none">{f.num}</span>
            <h3 class="text-lg font-bold text-slate-900">{f.title}</h3>
            <p class="text-slate-600 text-sm leading-relaxed max-w-[50ch]">{f.desc}</p>
            {f.image && (
              <div class="mt-3 w-full sm:w-96 rounded-sm overflow-hidden border border-slate-200 shadow-sm">
                <img src={f.image} alt="Arrastra un PDF y firma con tu perfil guardado" class="w-full h-auto object-cover" loading="lazy" />
              </div>
            )}
          </div>
        ))}

      </div>

    </div>
  </section>

  <!-- ════════════════════════ INTERFACE VIEWER (TABS) ════════════════════════ -->
  <section class="relative py-20 bg-penke-dark text-white overflow-hidden" id="capturas">
    <div class="guilloche-ground text-penke-teal opacity-60">
      <svg width="100%" height="100%"><rect width="100%" height="100%" fill="url(#guilloche)"/></svg>
    </div>
    <div class="relative max-w-6xl mx-auto px-6">

      <div class="text-center max-w-2xl mx-auto mb-10 reveal">
        <p class="font-serif text-3xl font-semibold tracking-tight">Así se ve firmar con Penké</p>
      </div>

      <div class="flex justify-center gap-6 mb-8 flex-wrap text-xs font-bold" id="screen-tabs" role="tablist">
        <button data-tab="home" role="tab" aria-selected="true" class="ledger-tab pb-2 cursor-pointer">Firma rápida</button>
        <button data-tab="firmar" role="tab" aria-selected="false" class="ledger-tab pb-2 cursor-pointer">Mis firmas</button>
        <button data-tab="verificar" role="tab" aria-selected="false" class="ledger-tab pb-2 cursor-pointer">Verificador de PDF</button>
        <button data-tab="validar" role="tab" aria-selected="false" class="ledger-tab pb-2 cursor-pointer">Validador de certificado</button>
      </div>

      <div class="max-w-5xl mx-auto reveal">
        <div class="cert-frame-dark">
          <svg class="corner-mark tl" viewBox="0 0 20 20" aria-hidden="true"><path d="M2 10H8M10 2V8" stroke="currentColor" stroke-width="1.4" fill="none"/><circle cx="10" cy="10" r="2.6" fill="none" stroke="currentColor" stroke-width="1"/></svg>
          <svg class="corner-mark tr" viewBox="0 0 20 20" aria-hidden="true"><path d="M2 10H8M10 2V8" stroke="currentColor" stroke-width="1.4" fill="none"/><circle cx="10" cy="10" r="2.6" fill="none" stroke="currentColor" stroke-width="1"/></svg>
          <svg class="corner-mark bl" viewBox="0 0 20 20" aria-hidden="true"><path d="M2 10H8M10 2V8" stroke="currentColor" stroke-width="1.4" fill="none"/><circle cx="10" cy="10" r="2.6" fill="none" stroke="currentColor" stroke-width="1"/></svg>
          <svg class="corner-mark br" viewBox="0 0 20 20" aria-hidden="true"><path d="M2 10H8M10 2V8" stroke="currentColor" stroke-width="1.4" fill="none"/><circle cx="10" cy="10" r="2.6" fill="none" stroke="currentColor" stroke-width="1"/></svg>
          <div class="bg-slate-950 px-5 py-2.5 border-b border-white/10 flex items-center justify-between">
            <span class="font-serif text-xs tracking-[0.15em] text-slate-300 uppercase">Penké</span>
            <span id="tab-title-display" class="font-mono text-[10px] text-slate-500 tracking-wide">Firma rápida</span>
          </div>

          <div class="aspect-[1376/768] overflow-hidden bg-slate-900">
            <div data-panel="home" class="screen-panel h-full">
              <img src="/screenshots/home.jpg" alt="Firma rápida" class="w-full h-full object-cover object-top" />
            </div>
            <div data-panel="firmar" class="screen-panel hidden h-full">
              <img src="/screenshots/firmar.jpg" alt="Mis firmas" class="w-full h-full object-cover object-top" />
            </div>
            <div data-panel="verificar" class="screen-panel hidden h-full">
              <img src="/screenshots/verificar.jpg" alt="Verificador de firmas PDF" class="w-full h-full object-cover object-top" />
            </div>
            <div data-panel="validar" class="screen-panel hidden h-full">
              <img src="/screenshots/validar.jpg" alt="Validador de certificados .p12" class="w-full h-full object-cover object-top" />
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ════════════════════ PRIVACIDAD Y DIFERENCIA ════════════════════ -->
  <section class="py-20 bg-slate-50 border-y border-slate-200" id="arquitectura">
    <div class="max-w-5xl mx-auto px-6">

      <div class="relative bg-white border border-slate-200 p-8 sm:p-12 reveal">
        <svg class="corner-mark tl" viewBox="0 0 20 20" aria-hidden="true" style="color:var(--color-penke-blue)"><path d="M2 10H8M10 2V8" stroke="currentColor" stroke-width="1.4" fill="none"/><circle cx="10" cy="10" r="2.6" fill="none" stroke="currentColor" stroke-width="1"/></svg>
        <svg class="corner-mark tr" viewBox="0 0 20 20" aria-hidden="true" style="color:var(--color-penke-blue)"><path d="M2 10H8M10 2V8" stroke="currentColor" stroke-width="1.4" fill="none"/><circle cx="10" cy="10" r="2.6" fill="none" stroke="currentColor" stroke-width="1"/></svg>
        <svg class="corner-mark bl" viewBox="0 0 20 20" aria-hidden="true" style="color:var(--color-penke-blue)"><path d="M2 10H8M10 2V8" stroke="currentColor" stroke-width="1.4" fill="none"/><circle cx="10" cy="10" r="2.6" fill="none" stroke="currentColor" stroke-width="1"/></svg>
        <svg class="corner-mark br" viewBox="0 0 20 20" aria-hidden="true" style="color:var(--color-penke-blue)"><path d="M2 10H8M10 2V8" stroke="currentColor" stroke-width="1.4" fill="none"/><circle cx="10" cy="10" r="2.6" fill="none" stroke="currentColor" stroke-width="1"/></svg>

        <div class="max-w-3xl">
          <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-slate-900 mb-4">
            Tus archivos y tu clave privada nunca salen de tu computadora
          </h2>
          <p class="text-slate-600 text-sm sm:text-base leading-relaxed mb-8 max-w-[62ch]">
            Todo el proceso de firma ocurre dentro de tu equipo. Ni tu documento ni tu contraseña se envían a ningún servidor, ni siquiera al nuestro.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-6 pt-6 border-t border-slate-200">
