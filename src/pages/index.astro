const bentoFeatures = [
  {
    num: "01",
    title: "Tu perfil de firma queda guardado",
    desc: "Sin repetir tu certificado cada vez que abres la app ni navegar carpeta por carpeta buscando el archivo. Arrastra el PDF desde donde esté y listo.",
    colSpan: "md:col-span-2",
  },
  {
    num: "02",
    title: "Visor PDF con estampa visual",
    desc: "Visualiza el documento antes de firmar y arrastra tu estampa visual exactamente a la página y coordenada requerida.",
    colSpan: "md:col-span-1",
  },
  {
    num: "03",
    title: "Soporte Token USB",
    desc: "Conecta tu token físico de firma (Security Data, BCE, Consejo de la Judicatura, ANF) y Penké lo detecta. Solo necesitas el driver oficial de tu proveedor.",
    colSpan: "md:col-span-1",
  },
  {
    num: "04",
    title: "Procesamiento de firma en lote",
    desc: "Firma carpetas completas de archivos PDF de facturación, contratos o trámites gubernamentales en un solo clic.",
    colSpan: "md:col-span-1",
  },
  {
    num: "05",
    title: "Localización Ecuador integrada",
    desc: "Autocomplete nativo con la división política oficial (provincias, cantones y parroquias) para la razón de firma.",
    colSpan: "md:col-span-1",
  },
];

const faqs = [
  {
    q: "¿Penké es lo mismo que la firma electrónica (FirmaEC) del MINTEL?",
    a: "No exactamente. Penké es una aplicación independiente que usa por dentro la librería oficial FirmaDigital del MINTEL para el proceso criptográfico, pero con una interfaz más simple y sin pasos técnicos aparte. Tu certificado de firma electrónica ecuatoriana (.p12 o Token USB) funciona igual que en la app oficial — Penké solo cambia cómo se usa, no quién lo emite ni lo valida."
  },
  {
    q: "¿Por qué no tengo que instalar Java por mi cuenta?",
    a: "Penké ya trae todo lo que necesita incluido. Descargas un solo instalador, lo abres, y queda listo para firmar — sin pasos adicionales ni programas sueltos que buscar."
  },
  {
    q: "¿Es compatible con mis certificados de Banco Central, Judicatura o Security Data?",
    a: "Sí. Penké reconoce certificados emitidos por entidades acreditadas en Ecuador y comprueba su vigencia antes de firmar. Para tokens USB, debes tener instalado el driver oficial de tu proveedor."
  },
  {
    q: "¿Mis documentos o mi contraseña se envían a algún servidor?",
    a: "Tus PDFs, tu certificado y tu clave privada permanecen en tu computadora. La aplicación puede consultar servicios oficiales para comprobar el estado de revocación o vigencia del certificado, pero nunca envía tu documento ni tu clave privada."
  },
  {
    q: "¿Tiene algún costo o límite de uso?",
    a: "Ninguno. Penké es software libre y de código abierto. Es completamente gratuito para uso personal, profesional o gubernamental."
  },
  {
    q: "¿Cómo revisa Penké que mi certificado sea válido?",
    a: "Penké revisa la vigencia, la identidad del titular y la entidad emisora. Cuando corresponde, consulta el estado de revocación del certificado antes de dejarte firmar."
  }
];
