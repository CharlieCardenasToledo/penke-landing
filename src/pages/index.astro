            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          Descargar Penké gratis
        </a>
        <p class="text-xs text-slate-400">Disponible para Windows — macOS y Linux, muy pronto.</p>
      </div>

    </div>
  </section>

  </main>

  <!-- AVISO LEGAL DE INDEPENDENCIA -->
  <div class="bg-slate-950 py-8 border-t border-slate-800 text-center text-xs text-slate-400">
    <div class="max-w-4xl mx-auto px-6 space-y-2">
      <p class="max-w-[68ch] mx-auto">
        <strong class="text-slate-300">Nota de independencia:</strong> Penké es un proyecto de software independiente y no es un producto oficial del Ministerio de Telecomunicaciones y de la Sociedad de la Información (MINTEL) de Ecuador.
      </p>
      <p class="text-[12px] text-slate-500 max-w-[68ch] mx-auto">
        Utiliza la librería FirmaDigital, distribuida bajo licencia GPL v3 por el MINTEL Ecuador, para el proceso criptográfico de firma. Licencia del proyecto Penké: MIT.
      </p>
    </div>
  </div>

  <!-- FOOTER -->
  <footer class="bg-slate-950 py-6 border-t border-slate-900 text-xs text-slate-400">
    <div class="max-w-6xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-2">
      <div class="py-2">© {new Date().getFullYear()} Charlie Cárdenas Toledo — Penké Open Source</div>
      <div class="flex gap-4">
        <a href="https://github.com/CharlieCardenasToledo/penke-ec" target="_blank" rel="noopener noreferrer" class="py-2 hover:text-slate-200">GitHub</a>
        <a href="https://github.com/CharlieCardenasToledo/penke-ec/blob/main/LICENSE" target="_blank" rel="noopener noreferrer" class="py-2 hover:text-slate-200">Licencia MIT</a>
      </div>
    </div>
  </footer>

  <!-- SCRIPT INTERACTIVO -->
  <script>
    // Header Blur & Shadow on scroll
    const navbar = document.getElementById("navbar");
    window.addEventListener("scroll", () => {
      if (window.scrollY > 20) {
        navbar?.classList.add("bg-white/95", "backdrop-blur-md", "border-slate-200", "shadow-sm", "scrolled");
        navbar?.classList.remove("border-transparent");
      } else {
        navbar?.classList.remove("bg-white/95", "backdrop-blur-md", "border-slate-200", "shadow-sm", "scrolled");
        navbar?.classList.add("border-transparent");
      }
    }, { passive: true });

    // Mobile menu toggle
    const mobileMenuBtn = document.getElementById("mobile-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    mobileMenuBtn?.addEventListener("click", () => {
      const isOpen = mobileMenu?.classList.toggle("hidden") === false;
      mobileMenuBtn.setAttribute("aria-expanded", String(isOpen));
      mobileMenuBtn.setAttribute("aria-label", isOpen ? "Cerrar menú" : "Abrir menú");
    });
    mobileMenu?.querySelectorAll("a").forEach(link => {
      link.addEventListener("click", () => mobileMenu.classList.add("hidden"));
    });

    // Tabs Controller
    const tabTitleMap: Record<string, string> = {
      home: "Inicio",
      firmar: "Firmar documento",
      verificar: "Comprobar firma",
      validar: "Comprobar certificado",
    };

    const tabTitleDisplay = document.getElementById("tab-title-display");

    document.querySelectorAll(".ledger-tab").forEach(btn => {
      btn.addEventListener("click", () => {
        const tabKey = btn.getAttribute("data-tab") || "home";

        document.querySelectorAll(".ledger-tab").forEach(t => t.setAttribute("aria-selected", "false"));
        btn.setAttribute("aria-selected", "true");

        if (tabTitleDisplay && tabTitleMap[tabKey]) {
          tabTitleDisplay.textContent = tabTitleMap[tabKey];
        }

        document.querySelectorAll(".screen-panel").forEach(p => p.classList.add("hidden"));
        document.querySelector(`[data-panel="${tabKey}"]`)?.classList.remove("hidden");

        document.querySelectorAll("[data-screen-link]").forEach(link => link.classList.remove("active"));
        document.querySelector(`[data-screen-link="${tabKey}"]`)?.classList.add("active");
      });
    });

    // Selector de estados de certificado (Comprobar certificado) — refleja
    // exactamente los 4 estados de ValidarPage.badge(): válido, caducado,
    // revocado, sin verificar.
    document.querySelectorAll(".cert-state-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        const state = btn.getAttribute("data-cert-state") || "valid";

        document.querySelectorAll(".cert-state-btn").forEach(b => {
          b.classList.remove("active");
          b.setAttribute("aria-pressed", "false");
        });
        btn.classList.add("active");
        btn.setAttribute("aria-pressed", "true");

        document.querySelectorAll(".cert-banner").forEach(b => b.classList.add("hidden"));
        document.querySelector(`[data-cert-banner="${state}"]`)?.classList.remove("hidden");
      });
    });

    // FAQ Accordion
    document.querySelectorAll(".faq-item").forEach(item => {
      const btn = item.querySelector(".faq-btn");
      const answer = item.querySelector(".faq-answer") as HTMLElement | null;
      const icon = item.querySelector(".faq-icon");

      btn?.addEventListener("click", () => {
        const isOpen = item.classList.toggle("open");
        btn?.setAttribute("aria-expanded", String(isOpen));
        if (answer) {
          answer.style.maxHeight = isOpen ? answer.scrollHeight + "px" : "0";
        }
        if (icon) {
          icon.textContent = isOpen ? "−" : "+";
        }
      });
    });

    // Firma rápida animada — un cursor agarra el PDF, lo arrastra hasta la
    // dropzone y hace clic en "firmar", igual que el flujo real de
    // HomePage.tsx (perfil ya elegido → dropzone → botón → guardado).
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!reduceMotion) {
      document.querySelectorAll("[data-sign-demo]").forEach(root => {
        const flyingFile = root.querySelector(".sign-demo-flying-file");
        const cursor     = root.querySelector(".sign-demo-cursor");
        const dropEmpty  = root.querySelector('[data-drop-state="empty"]');
        const dropFilled = root.querySelector('[data-drop-state="filled"]');
        const btnIdle    = root.querySelector('[data-btn-state="idle"]');
        const btnReady   = root.querySelector('[data-btn-state="ready"]');
        const btnEl      = root.querySelector("[data-sign-btn]");
        const toast      = root.querySelector(".sign-demo-toast");

        const steps = [
          () => { // 0 — reposo: dropzone vacía, botón inicial, cursor y toast ocultos
            flyingFile?.classList.remove("play");
            cursor?.classList.remove("play");
            dropEmpty?.classList.remove("hidden");
            dropFilled?.classList.add("hidden");
            btnIdle?.classList.remove("hidden");
            btnReady?.classList.add("hidden");
            toast?.classList.remove("show");
            btnEl?.classList.remove("press");
          },
          () => { // 1 — el cursor "agarra" el PDF y lo arrastra hacia la dropzone
            cursor?.classList.add("play");
            flyingFile?.classList.add("play");
          },
          () => { // 2 — se suelta: dropzone pasa a "archivo seleccionado"
            dropEmpty?.classList.add("hidden");
            dropFilled?.classList.remove("hidden");
            btnIdle?.classList.add("hidden");
            btnReady?.classList.remove("hidden");
          },
          () => { btnEl?.classList.add("press"); toast?.classList.add("show"); }, // 3 — el cursor hace clic + confirmación
          () => btnEl?.classList.remove("press"), // 4 — suelta el clic
        ];
        // Los tiempos 2/3/4 están calculados sobre la curva de sign-demo-cursor-path
        // (2.8s de duración): "suelta" ≈ 48%, "clic" ≈ 88%.
        const timings = [0, 300, 1644, 2764, 2914];
        const cycleMs = 5600;

        function playCycle() {
          timings.forEach((delay, i) => setTimeout(() => steps[i](), delay));
        }
        playCycle();
        setInterval(playCycle, cycleMs);
      });
    }

    // Reveal elements on scroll
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll(".reveal").forEach(el => observer.observe(el));
  </script>
</body>
</html>
